# Phusion Passenger (cPanel) — dondeclau.algomio.com

# Evita que Apache liste el contenido si Passenger no llega a arrancar.
Options -Indexes

PassengerEnabled on
PassengerAppRoot /home/algomio/public_html/dondeclau.algomio.com
PassengerAppEnv production
PassengerPython /home/algomio/virtualenv/public_html/dondeclau.algomio.com/3.13/bin/python
PassengerStartupFile passenger_wsgi.py

#php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
#php -- END cPanel-generated handler, do not edit
