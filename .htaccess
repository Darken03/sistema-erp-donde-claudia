# Phusion Passenger (cPanel) — dondeclau.algomio.com
#
# IMPORTANTE: reemplaza USERNAME por tu usuario real de cPanel y ajusta
# PassengerAppRoot si el dominio tiene un document root propio
# (por ejemplo /home/USERNAME/dondeclau.algomio.com en vez de public_html).

PassengerEnabled on
PassengerAppRoot /home/USERNAME/public_html
PassengerAppEnv production
PassengerPython /home/USERNAME/venv/bin/python
PassengerStartupFile passenger_wsgi.py

# Antes de recargar la app ejecuta desde el document root:
#   python manage.py collectstatic --noinput
# y asegúrate de que /static/ y /media/ estén disponibles para Apache.
